SUPERVISOR_START {"at": "2026-10-22T17:38:06.054290+08:00", "python": "/home/server/miniconda3/envs/isaacsim-5.1/bin/python", "conda_env": "isaacsim-5.1", "source_sha256": "ef80c26008799aae8066e1da9b0514a1e4f6592c05ee0a9a240f33dd4fbee077", "source": "import time, json, faulthandler, os, sys, hashlib, math\nfrom pathlib import Path\nfaulthandler.enable()\nfaulthandler.dump_traceback_later(20, repeat=True)\nprint('DIAG_START', json.dumps({'pid':os.getpid(),'python':sys.executable}),flush=True)\nfrom isaaclab.app import AppLauncher\nlauncher=AppLauncher(headless=True,device='cuda:0',kit_args='--/app/settings/persistent=false')\napp=launcher.app\nimport carb\nimport gymnasium as gym\nimport torch\nimport isaaclab.sim as sim_utils\nfrom isaaclab_tasks.utils import parse_env_cfg\nimport robot_lab.tasks\nimport robot_lab.tasks.manager_based.beyondmimic.mdp as mdp\nsettings=carb.settings.get_settings()\noriginal_init=sim_utils.SimulationContext.__init__\nkeys=['/persistent/physics/numThreads','/physics/physxDispatcher','/plugins/carb.tasking.plugin/threadCount','/app/asyncRendering','/app/asyncRenderingLowLatency','/app/settings/persistent']\ndef instrumented_init(self,*args,**kwargs):\n    original_init(self,*args,**kwargs)\n    print('ACTUAL_SETTINGS',json.dumps({k:settings.get(k) for k in keys}),flush=True)\n    print('ACTUAL_SIM_DEVICE',self.device,flush=True)\n    assert settings.get('/persistent/physics/numThreads') == 8\n    assert settings.get('/app/settings/persistent') is False\nsim_utils.SimulationContext.__init__=instrumented_init\ntask='RobotLab-Isaac-BeyondMimic-Flat-LW-wheel-v0'\ncfg=parse_env_cfg(task,device='cuda:0',num_envs=1)\ncfg.seed=42\ncfg.log_dir=None\ncfg.observations.policy.enable_corruption=False\nfor name in ['push_robot','randomize_apply_external_force_torque','add_joint_default_pos','base_com','physics_material','randomize_rigid_body_mass_base','randomize_rigid_body_mass_others','randomize_actuator_gains']:\n    if hasattr(cfg.events,name):\n        setattr(cfg.events,name,None)\ncfg.commands.motion.debug_vis=True\ncfg.commands.motion.pose_range={}\ncfg.commands.motion.velocity_range={}\ncfg.commands.motion.joint_position_range=(0.0,0.0)\nmotion=Path(cfg.commands.motion.motion_file)\nprint('ACTUAL_ENV_CONFIG',json.dumps({'task':task,'num_envs':cfg.scene.num_envs,'seed':cfg.seed,'device':cfg.sim.device,'dt':cfg.sim.dt,'decimation':cfg.decimation,'min_delay':cfg.scene.robot.actuators['legs'].min_delay,'max_delay':cfg.scene.robot.actuators['legs'].max_delay,'motion_file':str(motion),'motion_sha256':hashlib.sha256(motion.read_bytes()).hexdigest(),'robot_usd':cfg.scene.robot.spawn.usd_path,'policy_corruption':cfg.observations.policy.enable_corruption,'motion_debug_vis':cfg.commands.motion.debug_vis,'log_dir':cfg.log_dir,'export_io_descriptors':cfg.export_io_descriptors}),flush=True)\nprint('BEFORE_ENV_MAKE',flush=True)\nt=time.monotonic()\nenv=gym.make(task,cfg=cfg,render_mode=None)\nprint('ENV_MAKE_OK',time.monotonic()-t,flush=True)\nprint('BEFORE_ENV_RESET',flush=True)\nt=time.monotonic()\nobs,info=env.reset()\nprint('ENV_RESET_OK',json.dumps({'seconds':time.monotonic()-t,'observations':{k:list(v.shape) for k,v in obs.items()}}),flush=True)\nmotion=env.unwrapped.command_manager.get_term('motion')\nnew_names=['motion_takeoff_vertical_velocity','motion_flight_height']\nactive=env.unwrapped.reward_manager.active_terms\nassert all(name in active for name in new_names), active\nprint('NEW_REWARD_TERMS',json.dumps({name:{'weight':env.unwrapped.reward_manager.get_term_cfg(name).weight,'params':env.unwrapped.reward_manager.get_term_cfg(name).params} for name in new_names}),flush=True)\ndef scalar_window(t,start,end,ramp):\n    def smooth(x):\n        x=max(0.0,min(1.0,x))\n        return x*x*(3.0-2.0*x)\n    return smooth((t-start)/ramp)*smooth((end-t)/ramp)\nfps=float(motion.motion.fps.item())\nfor frame in [0,55,56,63,68,75,85]:\n    motion.time_steps.fill_(frame)\n    t_ref=frame/fps\n    vz=float(motion.robot.data.body_com_lin_vel_w[0,motion.robot_anchor_body_index,2])\n    vz_ref=float(motion.anchor_lin_vel_w[0,2])\n    z=float(motion.robot_anchor_pos_w[0,2])\n    z_ref=float(motion.anchor_pos_w[0,2])\n    velocity_config=env.unwrapped.reward_manager.get_term_cfg(new_names[0])\n    height_config=env.unwrapped.reward_manager.get_term_cfg(new_names[1])\n    velocity=velocity_config.func(env.unwrapped,**velocity_config.params)\n    height=height_config.func(env.unwrapped,**height_config.params)\n    error=(vz-vz_ref)/velocity_config.params['velocity_scale']\n    abs_error=abs(error)\n    expected_velocity=scalar_window(t_ref,1.10,1.36,0.04)*(0.5*error*error if abs_error<=1.0 else abs_error-0.5)\n    expected_height=scalar_window(t_ref,1.20,1.70,0.05)*math.exp(-((z-z_ref)/0.10)**2)\n    torch.testing.assert_close(velocity,torch.tensor([expected_velocity],dtype=velocity.dtype,device=velocity.device),atol=1e-6,rtol=1e-5)\n    torch.testing.assert_close(height,torch.tensor([expected_height],dtype=height.dtype,device=height.device),atol=1e-6,rtol=1e-5)\n    print('REWARD_PHASE_CHECK',json.dumps({'frame':frame,'reference_time_s':t_ref,'vz':vz,'vz_ref':vz_ref,'z':z,'z_ref':z_ref,'raw_velocity_huber':float(velocity[0]),'weighted_velocity':float(velocity[0])*velocity_config.weight,'raw_height_exp':float(height[0]),'weighted_height':float(height[0])*height_config.weight}),flush=True)\nmotion.time_steps.fill_(63)\nprint('REWARD_PHASE_CHECKS_OK',flush=True)\nactions=torch.zeros((env.unwrapped.num_envs,env.unwrapped.action_manager.total_action_dim),device=env.unwrapped.device)\nwith torch.inference_mode():\n    for i in range(3):\n        obs,reward,terminated,truncated,info=env.step(actions)\n        torch.cuda.synchronize()\n        print('ENV_STEP_OK',json.dumps({'step':i+1,'reward_finite':bool(torch.isfinite(reward).all()),'observation_finite':{k:bool(torch.isfinite(v).all()) for k,v in obs.items()},'terminated':terminated.tolist(),'truncated':truncated.tolist()}),flush=True)\nprint('ENV_PHYSICS_OK',flush=True)\nprint('BEFORE_ENV_CLOSE',flush=True)\nenv.close()\nprint('ENV_CLOSE_OK',flush=True)\nprint('BEFORE_APP_CLOSE',flush=True)\napp.close(wait_for_replicator=False)\nprint('APP_CLOSE_OK',flush=True)\nfaulthandler.cancel_dump_traceback_later()\n", "bound_seconds": 60}
