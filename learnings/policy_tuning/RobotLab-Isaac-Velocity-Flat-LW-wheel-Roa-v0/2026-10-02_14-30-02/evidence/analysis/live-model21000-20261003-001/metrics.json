  "analysis_kind": "bounded_current_training_assessment",
  "analysis_source": {
    "python": "def analyze(result_path, action_scale):\n result_path=Path(result_path);r=json.loads(result_path.read_text())\n tf=Path(r['telemetry_path']);t=json.loads(gzip.decompress(tf.read_bytes()));s=t['samples'];n=len(s)\n assert n==r['duration_steps'] and [z['step'] for z in s]==list(range(n))\n assert t['telemetry_status']=='complete' and not t['missing_required_signals']\n def arr(key): return np.array([z[key] for z in s],dtype=float)\n a=arr('action');vel=arr('joint_velocity');tor=arr('applied_torque');w=arr('root_angular_velocity_b');v=arr('root_linear_velocity_b');cmd=arr('command');pos=arr('root_position_w');q=arr('root_quaternion_w')\n assert all(np.isfinite(x).all() for x in [a,vel,tor,w,v,cmd,pos,q])\n assert t['step_dt_seconds']==.02 and t['stride']==1\n ids=[t['joint_names'].index(j) for j in joint_order];h=ids[:2];wheel=ids[8:]\n target=a*np.asarray(action_scale)\n done=np.array([z['done'] for z in s]); valid=np.ones(n,bool)\n for d in np.where(done)[0]: valid[d:min(n,d+50)]=False\n limits=np.array(t['joint_effort_limits'])\n yaw=np.unwrap(np.arctan2(2*(q[:,0]*q[:,3]+q[:,1]*q[:,2]),1-2*(q[:,2]**2+q[:,3]**2)))\n def spectral_band_rms(values,lo_hz):\n  centered=values-values.mean(axis=0,keepdims=True)\n  z=np.fft.rfft(centered,axis=0);freq=np.fft.rfftfreq(len(values),d=.02)\n  weight=np.full(len(freq),2.);weight[0]=1.\n  if len(values)%2==0:weight[-1]=1.\n  return np.sqrt(np.sum(abs(z[freq>=lo_hz])**2*weight[freq>=lo_hz,None],axis=0)/len(values)**2)\n stages={'startup_0_1s': [0, 50], 'straight_2_4s': [100, 200], 'turn_5_7s': [250, 350], 'stop_complete_7_10s': [350, 500], 'stop_later_8_10s': [400, 500]}\n result={'result':ref(result_path),'telemetry':ref(tf),'scenario':r['inputs']['scenario']['contract'],'telemetry_status':t['telemetry_status'],'official_metrics':r['metrics'],'done_steps':np.where(done)[0].tolist(),'timeout_steps':[z['step'] for z in s if z['timeout']],'stages':{},'joint_order':joint_order,'roa_diagnostic_signals_available': 'roa_student_velocity_b' in s[0]}\n for name,(lo,hi) in stages.items():\n  ix=np.arange(lo,hi)[valid[lo:hi]]; pairs=ix[1:][np.diff(ix)==1]\n  rms=lambda x:float(np.sqrt(np.mean(x*x)))\n  xx={'valid_samples':len(ix),'excluded_samples':hi-lo-len(ix),\n   'body_roll_pitch_angvel_rms_rad_s':float(np.sqrt(np.mean(np.sum(w[ix,:2]**2,axis=1)))),\n   'body_roll_pitch_angvel_peak_rad_s':float(np.max(np.linalg.norm(w[ix,:2],axis=1))),\n   'hip_target_rms_rad':rms(target[ix,:2]),'hip_target_peak_rad':float(np.max(abs(target[ix,:2]))),\n   'hip_target_step_rms_rad':rms(target[pairs,:2]-target[pairs-1,:2]),\n   'hip_velocity_rms_rad_s':rms(vel[ix][:,h]),'hip_velocity_peak_rad_s':float(np.max(abs(vel[ix][:,h]))),\n   'tracking_xy_rmse_m_s':rms(v[ix,:2]-cmd[ix,:2]),\n   'tracking_yaw_rmse_rad_s':rms(w[ix,2]-cmd[ix,2]),\n   'mean_body_velocity_xyz_m_s':v[ix].mean(axis=0).tolist(),'mean_body_yaw_rate_rad_s':float(w[ix,2].mean()),\n   'net_xy_displacement_m':None if done[lo:hi].any() else float(np.linalg.norm(pos[hi-1,:2]-pos[lo,:2])),\n   'world_heading_change_rad':None if done[lo:hi].any() else float(yaw[hi-1]-yaw[lo]),\n   'hip_torque_max_utilization':float(np.max(abs(tor[ix][:,h])/limits[h])),\n   'wheel_torque_max_utilization':float(np.max(abs(tor[ix][:,wheel])/limits[wheel])),\n   'per_joint_target_step_rms':[rms(target[pairs,j]-target[pairs-1,j]) for j in range(10)],\n   'per_joint_velocity_rms_rad_s':[rms(vel[ix,j]) for j in ids],\n   'per_joint_control_sampled_acceleration_rms_rad_s2':[rms((vel[pairs,j]-vel[pairs-1,j])/.02) for j in ids],\n   'per_joint_target_second_difference_rms':[rms(target[pairs[1:],j]-2*target[pairs[1:]-1,j]+target[pairs[1:]-2,j]) for j in range(10)] if not done.any() else None}\n  if len(ix)==hi-lo:\n   for cutoff in [5,10]:\n    band=spectral_band_rms(vel[ix][:,ids],cutoff)\n    xx[f'per_joint_velocity_band_{cutoff}_25Hz_rms_rad_s']=band.tolist()\n    xx[f'hip_velocity_band_{cutoff}_25Hz_rms_rad_s']=float(np.sqrt(np.mean(band[:2]**2)))\n    band=spectral_band_rms(target[ix],cutoff)\n    xx[f'per_joint_target_band_{cutoff}_25Hz_rms']=band.tolist()\n  if result['roa_diagnostic_signals_available']:\n   err=arr('roa_student_velocity_b')[ix]-arr('roa_true_velocity_b')[ix]\n   xx['estimated_velocity_error_rms_xyz_m_s']=np.sqrt(np.mean(err**2,axis=0)).tolist()\n   xx['estimated_velocity_bias_xyz_m_s']=err.mean(axis=0).tolist()\n  if len(ix)==hi-lo:\n   jp=arr('joint_position')[ix][:,h]\n   band=spectral_band_rms(jp,5)\n   xx['hip_position_band_5_25Hz_rms_rad']=float(np.sqrt(np.mean(band**2)))\n  result['stages'][name]=xx\n if result['roa_diagnostic_signals_available']:\n  result['student_action_max_error']=float(np.max(abs(a-arr('roa_student_action'))))\n  result['teacher_truth_max_error']=float(np.max(abs(arr('roa_teacher_velocity_b')-arr('roa_true_velocity_b'))))\n return result",
    "sha256": "feb157111ff03af3e60a3b0eee0264cea51f7f802d6eb11c7a812a2e7bef3f69"
