    "python": "import gzip,hashlib,json,sys,time\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nsys.path.insert(0,'scripts/reinforcement_learning/rsl_rl')\nsys.path.insert(0,'.agents/skills/monitor-tune-isaaclab-training/scripts')\nfrom policy_evaluation_evidence import validate_evaluation_bundle\nROOT=Path('/home/server/liufengrong/robot_lab')\nTASK='RobotLab-Isaac-Velocity-Flat-LW-wheel-Roa-v0';RUN='2026-09-29_21-23-15'\nBASE=ROOT/'learnings/policy_tuning'/TASK\nnewpath=BASE/RUN/'evidence/play/model29000-standing-forward-a01/result.json'\nprior={'ROA_0923_final':('2026-09-23_17-23-24','flat-roa-final-assess-20260924-001','2026-09-23_17-23-24/right-delay15-noise'),'ROA_0926_final_scale0125':('2026-09-26_11-37-09','flat-roa-scale-assess-20260928-001','right-delay15-noise'),'ROA_0928_final_no_velocity_scale0125':('2026-09-28_17-06-19','wheel-flat-no-velocity-assess-20260929-001','right-delay15-noise')}\ndef ref(p):return {'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}\ndef read_telemetry(r):\n p=Path(r['outputs']['telemetry']['path']);raw=p.read_bytes();assert hashlib.sha256(raw).hexdigest()==r['outputs']['telemetry']['sha256']\n return json.loads(gzip.decompress(raw) if p.suffix=='.gz' else raw)\ndef rms(a):return float(np.sqrt(np.mean(a*a)))\ndef band_rms(values,lo):\n centered=values-values.mean(axis=0,keepdims=True);z=np.fft.rfft(centered,axis=0);freq=np.fft.rfftfreq(len(values),.02)\n weight=np.full(len(freq),2.);weight[0]=1.;weight[-1]=1. if len(values)%2 else 1.\n return np.sqrt(np.sum(np.abs(z[freq>=lo])**2*weight[freq>=lo,None],axis=0)/len(values)**2)\ndef metrics(t,lo,hi):\n s=t['samples'];assert len(s)==2000 and [x['step'] for x in s]==list(range(2000))\n assert t['step_dt_seconds']==.02 and t['stride']==1 and t['telemetry_status']=='complete' and not t['missing_required_signals']\n assert not any(x['done'] or x['timeout'] for x in s[lo:hi])\n take=lambda k:np.asarray([x[k] for x in s[lo:hi]],dtype=np.float64)\n v,w,c,p,a,jv,jp=(take(k) for k in ('root_linear_velocity_b','root_angular_velocity_b','command','root_position_w','action','joint_velocity','joint_position'))\n hip=[t['joint_names'].index(x) for x in ('right_hip_joint','left_hip_joint')]\n target=a[:,:2]*.125\n est=take('roa_student_velocity_b');truth=take('roa_true_velocity_b')\n assert all(np.isfinite(x).all() for x in (v,w,c,p,a,jv,jp,est,truth))\n return {'samples':hi-lo,'body_roll_pitch_angvel_rms_rad_s':rms(np.linalg.norm(w[:,:2],axis=1)),'hip_target_rms_rad':rms(target),'hip_target_peak_rad':float(np.max(np.abs(target))),'hip_target_step_rms_rad':rms(np.diff(target,axis=0)),'hip_velocity_rms_rad_s':rms(jv[:,hip]),'hip_velocity_band_5_25Hz_rms_rad_s':rms(band_rms(jv[:,hip],5)),'hip_position_band_5_25Hz_rms_rad':rms(band_rms(jp[:,hip],5)),'tracking_xy_rmse_m_s':rms(v[:,:2]-c[:,:2]),'tracking_vx_rmse_m_s':rms(v[:,0]-c[:,0]),'tracking_yaw_rmse_rad_s':rms(w[:,2]-c[:,2]),'mean_body_vx_m_s':float(v[:,0].mean()),'mean_body_vy_m_s':float(v[:,1].mean()),'mean_body_yaw_rate_rad_s':float(w[:,2].mean()),'net_xy_displacement_m':float(np.linalg.norm(p[-1,:2]-p[0,:2])),'estimated_velocity_error_rms_xyz_m_s':np.sqrt(np.mean((est-truth)**2,axis=0)).tolist(),'estimated_velocity_bias_xyz_m_s':(est-truth).mean(axis=0).tolist()}\nassert validate_evaluation_bundle(newpath)['status']=='valid'\nnew=json.loads(newpath.read_bytes());tnew=read_telemetry(new)\nassert new['telemetry_status']=='complete' and not new['missing_required_signals'] and new['duration_steps']==2000 and new['training_overlap']\nsc=new['inputs']['scenario']['contract'];assert sc['num_envs']==1 and sc['seed']==42 and len(sc['command_schedule'])==2\nassert all(x['step']==i for i,x in enumerate(tnew['samples']))\nwindows={'standing_1_10s':(50,500),'straight_11_40s':(550,2000)}\ncurrent={name:metrics(tnew,*bounds) for name,bounds in windows.items()}\n# The historical policy values below come from archived analyses; their models are never loaded.\nold={};refs={};traces={}\nfor label,(run,aid,key) in prior.items():\n analysis=BASE/run/'evidence/analysis'/aid/'metrics.json';d=json.loads(analysis.read_bytes());case=d['cases'][key]\n rp=Path(case['result']['path']);assert ref(rp)==case['result'];assert validate_evaluation_bundle(rp)['status']=='valid'\n r=json.loads(rp.read_bytes());assert r['telemetry_status']=='complete' and not r['missing_required_signals'];hsc=r['inputs']['scenario']['contract']\n assert hsc['seed']==sc['seed'] and hsc['num_envs']==sc['num_envs'] and hsc['scenario_overrides']==sc['scenario_overrides'] and hsc['command_schedule'][:2]==sc['command_schedule']\n assert hsc['duration_steps']==4500 and case['done_steps']==[] and case['timeout_steps']==[]\n old[label]={name:case['stages'][name] for name in windows}\n refs[label]={'analysis':ref(analysis),'result':ref(rp),'telemetry':r['outputs']['telemetry']}\n t=read_telemetry(r);assert len(t['samples'])==4500\n traces[label]=np.asarray([x['root_linear_velocity_b'][0] for x in t['samples'][:2000]],dtype=float)\n# Exact formula used in the historical analysis is reproduced on the current telemetry.\nfor name,m in current.items():\n assert m['samples']==windows[name][1]-windows[name][0]\ncurrent_vx=np.asarray([x['root_linear_velocity_b'][0] for x in tnew['samples']],dtype=float)\ntraces['ROA_0929_model29000_estvel']=current_vx\nout=BASE/RUN/'evidence/analysis/closed-loop-prefix-model29000-20260930-001';out.mkdir(parents=True,exist_ok=False)\nfig,axes=plt.subplots(2,1,figsize=(13,8),constrained_layout=True)\ncmd=np.asarray([x['command'][0] for x in tnew['samples']],dtype=float);smooth=np.ones(50)/50\naxes[0].plot(np.arange(2000)*.02,cmd,color='black',ls='--',lw=1,label='command vx')\ncolors=['#63748c','#30a28d','#e5a23a','#db536a']\nfor (label,v),color in zip(traces.items(),colors):axes[0].plot(np.arange(2000)*.02,np.convolve(v,smooth,'same'),label=label,color=color,lw=1.2)\naxes[0].set(xlabel='time (s)',ylabel='body vx (m/s)',title='Matched first 40 s; 1 s moving mean');axes[0].legend(fontsize=8);axes[0].grid(alpha=.2)\nlabels=list(old)+['ROA_0929_model29000_estvel'];vals=[]\nfor label in labels:\n m=current['straight_11_40s'] if label==labels[-1] else old[label]['straight_11_40s']\n vals.append([m['tracking_xy_rmse_m_s'],m['hip_target_step_rms_rad'],m['hip_velocity_band_5_25Hz_rms_rad_s']])\nfor i,name in enumerate(['xy tracking RMSE (m/s)','hip target step RMS (rad)','hip velocity 5-25 Hz RMS (rad/s)']):\n axes[1].bar(np.arange(len(labels))+(i-1)*.24,[v[i] for v in vals],.24,label=name)\naxes[1].set_xticks(range(len(labels)),['ROA Sep23','ROA Sep26','ROA Sep28','ROA Sep29@29k']);axes[1].legend(fontsize=8);axes[1].grid(axis='y',alpha=.2);axes[1].set_title('Forward steady window: steps 550-1999')\nplot=out/'comparison.png';fig.savefig(plot,dpi=150);plt.close(fig)\nresult={'version':1,'created_at':datetime.now(timezone.utc).isoformat(),'analysis_kind':'bounded_native_prefix_comparison','new_model':'ROA_0929_model29000_estvel','current_windows':current,'historical_windows_reused':old,'historical_policy_inference_count':0,'historical_refs':refs,'new_result':ref(newpath),'new_telemetry':new['outputs']['telemetry'],'scenario_current':sc,'method':{'windows_half_open':{k:list(v) for k,v in windows.items()},'dt_s':.02,'target_mapping':'first two raw hip actions x current effective 0.125 rad action scale','velocity_source':'body-frame root linear velocity','tracking_xy':'sqrt(mean((body_vxy-command_vxy)^2)) over components and samples','hip_target_step':'within-window consecutive physical target first differences; no cross-transition pair','hip_velocity_band':'FFT Parseval 5-25 Hz of measured right and left hip velocities, after window mean removal','hip_position_band':'same FFT definition on measured hip positions','comparison_scope':'same seed, overrides, command prefix, one environment; current ends at 2000 while archives continue to 4500'},'verification':{'all_bundles_validated':True,'current_telemetry_complete':True,'all_historical_telemetry_complete':True,'scenario_prefix_equal':True,'historical_values_reused_without_policy_inference':True,'current_checkpoint_sha256':new['checkpoint_sha256']},'health_before':ref(BASE/RUN/'evidence/health/health-model29000-overlap-20260930-001.json'),'health_after':ref(BASE/RUN/'evidence/health/health-model29000-overlap-post-20260930-001.json'),'static_analysis':ref(BASE/RUN/'evidence/analysis/static-rightturn-model29000-20260930-001/metrics.json'),'artifacts':{'plot':ref(plot)},'analysis_source':{'python':DRIVER_SOURCE,'sha256':hashlib.sha256(DRIVER_SOURCE.encode()).hexdigest()},'limitations':['One seed and one environment; training-overlap evaluation.','Only standing and straight command stages were evaluated for current policy; no current Native turn/stop result.','Historical policies had separately trained weights and effective configurations, including different observation-noise magnitudes.','Archived historical values are from existing 4500-step runs, restricted to the matching first-2000-step windows.','No criteria approved for convergence or hardware readiness.'],'direct_parameter_change_supported':False,'policy_description_required':'仅可进入受监督实物测试；未经实物验证，不代表 hardware-ready。'}\npath=out/'metrics.json'\nwith path.open('x') as f:json.dump(result,f,indent=2,ensure_ascii=False,allow_nan=False);f.write('\\n')\nprint(json.dumps({'metrics':ref(path),'current':current,'old_straight':{k:{m:v['straight_11_40s'][m] for m in ('tracking_xy_rmse_m_s','hip_target_step_rms_rad','hip_velocity_band_5_25Hz_rms_rad_s','mean_body_velocity_xyz_m_s')} for k,v in old.items()}},ensure_ascii=False))\n",
