  "definitions": {
    "eligibility": "Exactly five complete frame-zero successful cycles and no policy failed episodes for every matching scenario; censored tail retained separately.",
    "flight": "Longest all-four-contact-Fz<10N interval near planned flight; positive normal contact threshold only. Duration comparison to 300 ms is operational contact timing.",
    "impulse": "First any-wheel-contact detection bin and next nine consecutive 5ms bins: positive sum of both wheel normal Fz *0.005; includes support force; no friction or calibrated real peak.",
    "landing_speed": "At each wheel first Fz>10N in [1.3,2.1), its wheel-center velocity before that physics step; downward component max(-vz,0). Maximum over both wheels and five cycles. Not whole-robot COM speed.",
    "phase_windows": "preparation command frames [0,1.1); push-off [1.1,1.3); planned flight [1.3,1.6); landing [1.6,2.1). Boundaries follow original approved analysis.",
    "physics_time": "frame/50 +(substep+1)*0.005, end of bin; torque/force sampled every physics substep",
    "prep_foot_demand": "Computed requested joint torque >27 Nm; total 5 ms joint bins divided by complete cycles. Demand exceedance indicator, not every possible velocity-dependent clipping event.",
    "resource_difference": "New cases explicitly overlap live training; historical 49999 cases idle. Fixed physics/control dt; wall FPS and real-time factor excluded from policy ranking.",
    "shank_load": "Applied shank joint torque during push-off; not measured structural stress."
  },
