{"argv": ["/home/server/miniconda3/envs/isaacsim-5.1/bin/python", "-c", "import os\nimport runpy\nimport sys\nfrom pathlib import Path\n\ndef observe():\n    target = Path(sys.argv[1]).resolve()\n    sys.argv = sys.argv[1:]\n    sys.path[0] = str(target.parent)\n    source = target.read_text().splitlines()\n    lines = [i for i, line in enumerate(source, 1) if line.strip() == 'env_index = args_cli.telemetry_env_index']\n    if len(lines) != 1:\n        raise RuntimeError('Expected one existing per-step telemetry recording site')\n    line_number = lines[0]\n    result = Path(sys.argv[sys.argv.index('--result_path') + 1])\n    limit = int(sys.argv[sys.argv.index('--duration_steps') + 1])\n    rows = []\n    def record(frame, event, arg):\n        if event == 'line' and frame.f_lineno == line_number:\n            context = frame.f_locals\n            step = context['step']\n            if step != len(rows):\n                raise RuntimeError('Noncontiguous population telemetry')\n            scene = context['env'].unwrapped\n            robot = scene.scene['robot'].data\n            torch = frame.f_globals['torch']\n            fields = [robot.root_pos_w, robot.root_quat_w, context['root_linear_velocity'],\n                      context['root_angular_velocity'], context['command'],\n                      context['dones_tensor'].reshape(-1,1), context['timeouts'].reshape(-1,1)]\n            rows.append(torch.cat(fields, dim=-1).detach().cpu().numpy().copy())\n            if len(rows) == limit:\n                import numpy as np\n                names = ['pos_x','pos_y','pos_z','quat_w','quat_x','quat_y','quat_z',\n                         'lin_b_x','lin_b_y','lin_b_z','ang_b_x','ang_b_y','ang_b_z',\n                         'cmd_x','cmd_y','cmd_yaw','done','timeout']\n                with (result.parent/'standing-all-envs.npz').open('xb') as stream:\n                    np.savez_compressed(stream, states=np.stack(rows), step_dt=scene.step_dt, columns=names)\n                    stream.flush()\n                    os.fsync(stream.fileno())\n        return record\n    def dispatch(frame, event, arg):\n        if event == 'call' and frame.f_code.co_name == '_evaluate' and frame.f_code.co_filename == str(target):\n            return record\n        return None\n    sys.settrace(dispatch)\n    try:\n        runpy.run_path(str(target), run_name='__main__')\n    finally:\n        sys.settrace(None)\nobserve()\n", "/home/server/liufengrong/robot_lab/scripts/reinforcement_learning/rsl_rl/evaluate_policy.py", "--task", "RobotLab-Isaac-Velocity-Flat-LW-leg-CommandAmp-v0", "--run_id", "2026-11-26_21-23-35", "--batch_id", "commandamp-50000-stand-population-20261127-005", "--evaluation_id", "stand-randomized-population-a05", "--candidate_id", "model_50000", "--checkpoint", "/home/server/liufengrong/robot_lab/logs/rsl_rl/LW_leg_flat_command_amp/2026-11-26_21-23-35/model_50000.pt", "--checkpoint_sha256", "ee5d545435abc93210daf4cf4a58577c983748092f771870a1829086624f6ab6", "--artifact_kind", "native", "--artifact_path", "/home/server/liufengrong/robot_lab/logs/rsl_rl/LW_leg_flat_command_amp/2026-11-26_21-23-35/model_50000.pt", "--artifact_sha256", "ee5d545435abc93210daf4cf4a58577c983748092f771870a1829086624f6ab6", "--run_identity_path", "/home/server/liufengrong/robot_lab/learnings/policy_tuning/RobotLab-Isaac-Velocity-Flat-LW-leg-CommandAmp-v0/2026-11-26_21-23-35/provenance/context-b22e8c643f8c955047f7c23ab89f996282ef7dc5455869046c98606e95abfb91.json", "--run_identity_file_sha256", "b22e8c643f8c955047f7c23ab89f996282ef7dc5455869046c98606e95abfb91", "--effective_config_reference_json", "{\"path\": \"/home/server/liufengrong/robot_lab/learnings/policy_tuning/RobotLab-Isaac-Velocity-Flat-LW-leg-CommandAmp-v0/2026-11-26_21-23-35/provenance/config-9e79991ae8b2a0be75322c5cfaf90f2e751bc82883ea82397dac2145c28b518f.json\", \"sha256\": \"9e79991ae8b2a0be75322c5cfaf90f2e751bc82883ea82397dac2145c28b518f\"}", "--scenario_evidence_reference_json", "{\"path\"