  "method": {
    "analysis_source": "\ndef load_telemetry(result_path):\n    result=json.loads(result_path.read_text())\n    from policy_evaluation_evidence import validate_evaluation_bundle\n    validate_evaluation_bundle(result_path)\n    t=json.loads(gzip.decompress(Path(result[\"telemetry_path\"]).read_bytes()))\n    assert t[\"telemetry_status\"]==\"complete\" and not t[\"missing_required_signals\"]\n    return result,t\n\ndef euler(q):\n    q=q/np.linalg.norm(q,axis=-1,keepdims=True)\n    w,x,y,z=q.T\n    return np.stack([np.arctan2(2*(w*x+y*z),1-2*(x*x+y*y)),\n                     np.arcsin(np.clip(2*(w*y-z*x),-1,1)),\n                     np.arctan2(2*(w*z+x*y),1-2*(y*y+z*z))],axis=-1)\n\ndef quat_rotate(q,v):\n    q=q/np.linalg.norm(q,axis=-1,keepdims=True)\n    a=2*np.cross(q[:,1:],v)\n    return v+q[:,:1]*a+np.cross(q[:,1:],a)\n\ndef longest(mask,records):\n    best=length=0; prev=None\n    for ok,row in zip(mask,records):\n        if prev is None or row[\"episode_id\"]!=prev[\"episode_id\"] or row[\"physics_step\"]!=prev[\"physics_step\"]+1:\n            length=0\n        length=length+1 if ok else 0;best=max(best,length);prev=row\n    return best\n\ndef analyze(result_path):\n    result,t=load_telemetry(result_path)\n    s=t[\"samples\"];p=t[\"physics_samples\"]; d=t[\"motion_diagnostics\"]\n    fps=d[\"fps\"];dt=d[\"physics_window\"][\"physics_dt_seconds\"];nj=len(t[\"joint_names\"])\n    ct=np.array([r[\"frame_index\"]/fps for r in s]);pt=np.array([r[\"frame_index\"]/fps for r in p])\n    ce=np.array([r[\"episode_id\"] for r in s]);pe=np.array([r[\"episode_id\"] for r in p])\n    valid=~np.array([r[\"done\"] for r in s],dtype=bool)\n    finished={r[\"episode_id\"] for r in s if r[\"done\"] and r[\"termination_terms\"].get(\"motion_finished\") and not any(v for k,v in r[\"termination_terms\"].items() if k not in {\"motion_finished\",\"time_out\"})}\n    failures=[r for r in s if r[\"done\"] and r[\"episode_id\"] not in finished]\n    ended={r[\"episode_id\"] for r in s if r[\"done\"]}\n    q=np.array([r[\"root_quaternion_w\"] for r in s]);angles=euler(q)\n    refq=np.array([r[\"reference_body_quaternion_w\"] for r in s]).reshape(-1,len(d[\"body_names\"]),4)[:,d[\"body_names\"].index(\"base_link\")]\n    refangles=euler(refq); angle_errors=np.arctan2(np.sin(angles-refangles),np.cos(angles-refangles))\n    z=np.array([r[\"root_position_w\"][2] for r in s])\n    zref=np.array([r[\"reference_body_position_w\"] for r in s]).reshape(-1,len(d[\"body_names\"]),3)[:,d[\"body_names\"].index(\"base_link\"),2]\n    vz=quat_rotate(q,np.array([r[\"root_linear_velocity_b\"] for r in s]))[:,2]\n    jp=np.array([r[\"joint_position\"] for r in s]); jref=np.array([r[\"reference_joint_position\"] for r in s])\n    hi=[t[\"joint_names\"].index(n) for n in [\"right_hip_joint\",\"left_hip_joint\"]]\n    mirror=np.sum((jp-jref)[:,hi],axis=-1)\n    wheels=np.array([r[\"wheel_center_position_w\"] for r in p]).reshape(-1,2,3)\n    distance=np.linalg.norm(wheels[:,0,:2]-wheels[:,1,:2],axis=-1)\n    force=np.array([r[\"contact_forces_w\"] for r in p]).reshape(-1,len(d[\"contact_body_names\"]),3)\n    wi=[d[\"contact_body_names\"].index(n) for n in [\"right_wheel_link\",\"left_wheel_link\"]]\n    fz=force[:,wi,2]\n    ground=np.array([r[\"ground_contact_forces_w\"] for r in p]).reshape(-1,4,3)\n    total_fz=np.maximum(force[:,:,2],0).sum(-1)+np.maximum(ground[:,:,2],0).sum(-1)\n    prep=(pt>=0.1)&(pt<1.25); earlyprep=(pt>=0.1)&(pt<=1.1);hipwin=valid&(ct>=1)&(ct<=1.8)\n    posewin=valid&(ct>=0.8)&(ct<=1.4);late=valid&(ct>=1.5)&(ct<=2)\n    cycles=[]\n    for eid in sorted(finished):\n        cm=(ce==eid)&valid;pm=pe==eid\n        jump=cm&(ct>=1.1)&(ct<=1.36); land=pm&(pt>=1.5)&(pt<=2)\n        cycles.append({\"episode_id\":int(eid),\"takeoff_vz_peak_m_s\":float(vz[jump].max()) if jump.any() else None,\n                       \"height_peak_m\":float(z[cm].max()),\"landing_peak_1p5_2s_n\":float(total_fz[land].max()) if land.any() else None})\n    means={k:float(np.mean([r[k] for r in cycles if r[k] is not None])) if any(r[k] is not None for r in cycles) else None for k in [\"takeoff_vz_peak_m_s\",\"height_peak_m\",\"landing_peak_1p5_2s_n\"]}\n    hist=d[\"observation_history\"][\"reset_checks\"]\n    history_ok=all(r[\"command_matches_reference\"] and all(v[\"input_matches_history\"] and v[\"repeated_current_frame\"] for v in r[\"history_terms\"].values()) for r in hist)\n    metrics={\"completed_cycles\":len(finished),\"failed_episodes\":len(failures),\"censored_episodes\":len(set(ce)-ended),\n             \"control_samples\":len(s),\"physics_samples\":len(p),\"history_reset_passed\":bool(history_ok),\n             \"pitch_tracking_rmse_deg\":float(np.rad2deg(np.sqrt(np.mean(angle_errors[valid,1]**2)))),\n             \"roll_abs_peak_deg\":float(np.rad2deg(np.abs(angles[valid,0]).max())),\n             \"pitch_abs_peak_deg\":float(np.rad2deg(np.abs(angles[valid,1]).max())),\n             \"roll_abs_peak_0p8_1p4s_deg\":float(np.rad2deg(np.abs(angles[posewin,0]).max())) if posewin.any() else None,\n             \"hip_mirror_peak_1_1p8s_deg\":float(np.rad2deg(np.abs(mirror[hipwin]).max())) if hipwin.any() else None,\n             \"anchor_z_abs_error_max_m\":float(np.abs(z-zref)[valid].max()),\n             \"landing_z_rmse_1p5_2s_m\":float(np.sqrt(np.mean((z-zref)[late]**2))) if late.any() else None,\n             \"wheel_distance_min_m\":float(distance[prep].min()) if prep.any() else None,\n             \"wheel_distance_max_m\":float(distance[prep].max()) if prep.any() else None,\n             \"wheel_distance_outside_fraction\":float(np.mean((distance[prep]<0.496)|(distance[prep]>0.536))) if prep.any() else None,\n             \"bilateral_support_fraction_0p1_1p25s\":float(np.mean(np.all(fz[prep]>10,axis=-1))) if prep.any() else None,\n             \"bilateral_support_fraction_0p1_1p1s\":float(np.mean(np.all(fz[earlyprep]>10,axis=-1))) if earlyprep.any() else None,\n             \"ground_thigh_shank_force_peak_n\":float(np.linalg.norm(ground,axis=-1).max()),\n             \"ground_thigh_shank_contact_samples_above_1n\":int(np.count_nonzero(np.linalg.norm(ground,axis=-1).max(-1)>1)),\n             \"completed_cycle_means\":means,\"per_completed_cycle\":cycles,\n             \"termination_counts\":{k:sum(bool(r[\"termination_terms\"].get(k)) for r in s if r[\"done\"]) for k in s[0][\"termination_terms\"]}}\n    pair_change=np.diff(jp[:,hi[0]])\n    consecutive=(np.diff(ce)==0)&(np.diff(np.array([r[\"frame_index\"] for r in s]))==1)&hipwin[1:]&valid[:-1]\n    metrics[\"right_hip_single_20ms_peak_change_deg\"]=float(np.rad2deg(np.abs(pair_change[consecutive]).max())) if consecutive.any() else None\n    vel=np.array([r[\"joint_velocity\"] for r in p]);torque=np.array([r[\"applied_torque\"] for r in p]);eff=np.asarray(t[\"joint_effort_limits\"])\n    joints=[]\n    for j,name in enumerate(t[\"joint_names\"]):\n        vmax=33. if \"wheel\" in name else 10. if \"foot\" in name else 20.\n        peak=int(np.argmax(np.abs(vel[:,j])));sat=np.abs(torque[:,j])>=eff[j]-1e-5;over=np.abs(vel[:,j])>vmax\n        joints.append({\"joint\":name,\"velocity_peak_rad_s\":float(np.abs(vel[:,j]).max()),\"velocity_rms_rad_s\":float(np.sqrt(np.mean(vel[:,j]**2))),\"nominal_velocity_limit_rad_s\":vmax,\"overspeed_samples\":int(over.sum()),\"overspeed_total_ms\":float(over.sum()*dt*1000),\"overspeed_longest_ms\":float(longest(over,p)*dt*1000),\"velocity_peak_phase_s\":float(pt[peak]+p[peak][\"substep\"]*dt),\"velocity_peak_episode\":int(pe[peak]),\"applied_torque_at_velocity_peak_nm\":float(torque[peak,j]),\"torque_peak_nm\":float(np.abs(torque[:,j]).max()),\"torque_rms_nm\":float(np.sqrt(np.mean(torque[:,j]**2))),\"effort_limit_nm\":float(eff[j]),\"saturation_samples\":int(sat.sum()),\"saturation_total_ms\":float(sat.sum()*dt*1000)})\n    metrics[\"joint_limits\"]=joints\n    return metrics,{\"ct\":ct,\"pt\":pt,\"ce\":ce,\"pe\":pe,\"roll\":np.rad2deg(angles[:,0]),\"pitch\":np.rad2deg(angles[:,1]),\"distance\":distance,\"force\":total_fz,\"wheel_fz\":fz,\"z\":z,\"zref\":zref,\"hip\":np.rad2deg(jp[:,hi]),\"valid\":valid}\n",
