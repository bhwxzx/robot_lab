  "analysis_source": "import json,gzip,math,sys,hashlib\nimport numpy as np\nfrom pathlib import Path\nsys.path.insert(0,'scripts/reinforcement_learning/rsl_rl')\nfrom policy_evaluation_evidence import validate_evaluation_bundle\nbase=Path('learnings/policy_tuning/RobotLab-Isaac-BeyondMimic-Flat-LW-wheel-v0/2026-11-04_11-29-16/evaluations/wheel-to-leg-fixed-start-20261105-001').resolve()\ndef rot(q,v):\n q=np.array(q);q=q/np.linalg.norm(q);v=np.array(v);a=2*np.cross(q[1:],v);return v+q[0]*a+np.cross(q[1:],a)\ndef angles(q):\n w,x,y,z=np.array(q)/np.linalg.norm(q);return math.atan2(2*(w*x+y*z),1-2*(x*x+y*y)),math.atan2(2*(w*z+x*y),1-2*(y*y+z*z))\ndatasets={};inputs=[]\nfor case in ['nominal','randomized']:\n p=base/'raw'/('fixed-start-'+case+'-a01')\n validate_evaluation_bundle(p/'result.json')\n with gzip.open(p/'telemetry.json.gz','rt') as f:t=json.load(f)\n datasets[case]=t\n for name in ['result.json','telemetry.json.gz']:\n  inputs.append(dict(path=str(p/name),sha256=hashlib.sha256((p/name).read_bytes()).hexdigest()))\nnominal=datasets['nominal']['motion_diagnostics']['initial_runtime']\nallrows=[];stats=[];physics={};fkerr=0\nfor case,t in datasets.items():\n d=t['motion_diagnostics'];rt=d['initial_runtime'];bn=d['body_names'];rn=rt['body_names'];mass=np.array(rt['masses_kg']);com=np.array(rt['coms'])[:,:3];ji=[t['joint_names'].index(n) for n in ['left_hip_joint','right_hip_joint']]\n phys={}\n for p in t['physics_samples']:phys[(p['episode_id'],p['frame_index'])]=p\n for s in t['samples']:\n  time=s['frame_index']/d['fps']+.02\n  if s['done'] or not .9<=time<=1.7:continue\n  p=phys[(s['episode_id'],s['frame_index'])];assert abs(p['sim_time_seconds']-s['sim_time_seconds'])<1e-6 and p['substep']==3\n  pos=np.array(s['body_position_w']).reshape(-1,3);quat=np.array(s['body_quaternion_w']).reshape(-1,4);wheels=np.array(p['wheel_center_position_w']).reshape(2,3)\n  poses={n:(pos[i],quat[i]) for i,n in enumerate(bn)}\n  for wi,side in enumerate(['right','left']):\n   n=side+'_wheel_link';sh=bn.index(side+'_shank_link');c=com[rn.index(n)];assert abs(c[0])+abs(c[2])<1e-8\n   origin=[-.183850,(-.061 if side=='right' else .061),-.183850]\n   fkerr=max(fkerr,float(np.linalg.norm(pos[sh]+rot(quat[sh],origin)-wheels[wi])))\n   poses[n]=(wheels[wi],quat[sh])\n  def center(runtime):\n   return sum(m*(poses[n][0]+rot(poses[n][1],c[:3])) for m,n,c in zip(runtime['masses_kg'],runtime['body_names'],runtime['coms']))/sum(runtime['masses_kg'])\n  cw=center(rt);cn=center(nominal);mid=wheels.mean(0)\n  roll,yaw=angles(s['root_quaternion_w']);lateral=np.array([-math.sin(yaw),math.cos(yaw),0])\n  q=np.degrees(np.array(s['joint_position'])[ji]);ref=np.degrees(np.array(s['reference_joint_position'])[ji]);force=np.array(s['contact_forces_w']).reshape(-1,3)[:,2]\n  allrows.append(dict(case=case,episode=s['episode_id'],time=round(time,6),L=q[0],R=q[1],refL=ref[0],refR=ref[1],hip_common_error=(sum(q-ref)/2),roll=math.degrees(roll),com_cm=float((cw-mid)@lateral*100),nominal_mass_com_same_pose_cm=float((cn-mid)@lateral*100),base_cm=float((np.array(s['root_position_w'])-mid)@lateral*100),right_Fz=force[2],left_Fz=force[3]))\n for ep in sorted(set(r['episode_id'] for r in t['physics_samples'])):\n  ps=[r for r in t['physics_samples'] if r['episode_id']==ep]\n  ts=np.array([r['frame_index']/50+(r['substep']+1)*.005 for r in ps])\n  f=np.array([r['contact_forces_w'] for r in ps]).reshape(-1,4,3)[:,:,2]\n  g=np.array([r['ground_contact_forces_w'] for r in ps]).reshape(-1,4,3)[:,:,2]\n  physics[(case,ep)]=(ts,f,g)\n  # Find first persistent monitored-contact unloading; dwell 15 ms, analysis window 1.15..1.6 s.\n  rec=dict(case=case,episode=ep,complete=any(s['episode_id']==ep and s['done'] and s['termination_terms'].get('motion_finished') for s in t['samples']))\n  for th in [1,10,20]:\n   off=np.all(np.concatenate([f,g],axis=1)<th,axis=1)\n   cand=[i for i in range(len(ps)-2) if 1.15<=ts[i]<=1.6 and all(off[i:i+3])]\n   if not cand:rec['unload_'+str(th)]=None;continue\n   i=cand[0];times=[]\n   for wi in [2,3]:\n    prev=np.where((ts<=ts[i])&(f[:,wi]>=th))[0]\n    j=int(prev[-1]+1) if len(prev) else 0\n    times.append(float(ts[j]))\n   rec['unload_'+str(th)]=dict(right=times[0],left=times[1],lag_ms=round((times[1]-times[0])*1000,3),all8=float(ts[i]))\n  rows=[r for r in allrows if r['case']==case and r['episode']==ep and 1.1<=r['time']<=1.38]\n  rec.update(hip_common_peak=max(rows,key=lambda r:abs(r['hip_common_error'])),roll_peak=max(rows,key=lambda r:abs(r['roll'])),com_peak=max(rows,key=lambda r:abs(r['com_cm'])))\n  mask=(ts>=1.1)&(ts<=1.3)\n  rec['wheel_impulse_1p1_1p3_Ns']=(np.maximum(f[mask,2:],0).sum(axis=0)*.005).tolist()\n  stats.append(rec)\n",
  "method": {
    "control_time": "frame_before_action / 50 + 0.020 s",
    "physics_time": "frame_before_action / 50 + (substep_zero_based + 1) * 0.005 s",
    "hip_common_error": "((qL-qLref)+(qR-qRref))/2 in degrees",
    "com": "sum(m_i*(link_origin_i + R_i*local_COM_i))/sum(m_i); yaw-only lateral projection relative to current wheel-center midpoint; wheels have local COM on spin axis",
    "same_pose_nominal": "Algebraic recomputation with nominal masses and local COMs at the recorded randomized poses; not a dynamics counterfactual",
    "unloading": "Final wheel Fz below threshold before first >=15 ms all-eight monitored contacts below threshold in 1.15..1.6 s; thresholds 1,10,20 N; not proof all robot contacts absent",
    "caution": "Initial runtime physics sample is shared across episodes; nominal cycles repeat. No causal inference or hardware acceptance."
  },
