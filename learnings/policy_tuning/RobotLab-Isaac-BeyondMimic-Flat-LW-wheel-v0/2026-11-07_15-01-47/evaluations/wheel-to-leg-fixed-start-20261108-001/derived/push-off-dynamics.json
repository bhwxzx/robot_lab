  "version": 1,
  "source": "from pathlib import Path\nimport json,gzip,sys,hashlib,xml.etree.ElementTree as ET\nimport numpy as np\nroot=Path.cwd();sys.path.insert(0,str(root/'scripts/reinforcement_learning/rsl_rl'))\nfrom diagnose_motion_policy_symmetry import rotation_matrix as R\nbase=root/'learnings/policy_tuning/RobotLab-Isaac-BeyondMimic-Flat-LW-wheel-v0'\nout=base/'2026-11-07_15-01-47/evaluations/wheel-to-leg-fixed-start-20261108-001/derived'\na=json.loads((out/'analysis.json').read_text())\nref=lambda p:{'path':str(p),'sha256':hashlib.sha256(Path(p).read_bytes()).hexdigest()}\nurdf=root/'source/robot_lab/data/Robots/LW/LW_description/LW.urdf'\njoints=[]\nfor j in ET.parse(urdf).getroot().findall('joint'):\n assert np.allclose(np.fromstring(j.find('origin').get('rpy'),sep=' '),0)\n joints.append((j.get('name'),j.find('parent').get('link'),j.find('child').get('link'),np.fromstring(j.find('origin').get('xyz'),sep=' '),np.fromstring(j.find('axis').get('xyz'),sep=' ')))\nruns={'no_height':('2026-11-05_16-40-14','wheel-to-leg-fixed-start-20261106-001'),'height':('2026-11-06_11-39-51','wheel-to-leg-fixed-start-20261107-001'),'current':('2026-11-07_15-01-47','wheel-to-leg-fixed-start-20261108-001')}\nstats={};inputs=[ref(out/'analysis.json'),ref(urdf)];max_fk=0.;max_v=0.;max_closure=0.\nfor version,(run,batch) in runs.items():\n stats[version]={}\n for case in ['nominal','randomized']:\n  p=base/run/'evaluations'/batch/'raw'/f'fixed-start-{case}-a01/telemetry.json.gz'\n  with gzip.open(p,'rt') as f:t=json.load(f)\n  inputs.append(ref(p));md=t['motion_diagnostics'];rt=md['initial_runtime'];bn=md['body_names'];jn=t['joint_names'];mass=sum(rt['masses_kg'])\n  pd={(s['episode_id'],s['frame_index']):s for s in t['physics_samples'] if s['substep']==3}\n  cr={}\n  for s in t['samples']:\n   time=s['frame_index']/50+.02\n   if not 1.0<=time<=1.8:continue\n   ph=pd[s['episode_id'],s['frame_index']];pos=np.asarray(s['body_position_w']).reshape(-1,3);quat=np.asarray(s['body_quaternion_w']).reshape(-1,4)\n   positions=dict(zip(bn,pos));rots={n:R(q) for n,q in zip(bn,quat)}\n   for i,side in enumerate(['right','left']):\n    n=side+'_wheel_link';positions[n]=np.asarray(ph['wheel_center_position_w']).reshape(2,3)[i];rots[n]=rots[side+'_shank_link']\n    c=np.asarray(rt['coms'][rt['body_names'].index(n)])[:3];assert abs(c[0])+abs(c[2])<1e-8\n   omega={'base_link':rots['base_link']@s['root_angular_velocity_b']}\n   rb=rots['base_link']@np.asarray(rt['coms'][rt['body_names'].index('base_link')])[:3]\n   vel={'base_link':rots['base_link']@s['root_linear_velocity_b']-np.cross(omega['base_link'],rb)}\n   axes={}\n   for name,parent,child,offset,axis in joints:\n    max_fk=max(max_fk,float(np.linalg.norm(positions[parent]+rots[parent]@offset-positions[child])))\n    vel[child]=vel[parent]+np.cross(omega[parent],positions[child]-positions[parent])\n    axes[child]=rots[parent]@axis;omega[child]=omega[parent]+axes[child]*s['joint_velocity'][jn.index(name)]\n   whole=sum(m*(vel[n]+np.cross(omega[n],rots[n]@np.array(c)[:3])) for m,n,c in zip(rt['masses_kg'],rt['body_names'],rt['coms']))/mass\n   slips=[];forces=np.asarray(ph['contact_forces_w']).reshape(4,3)[:,2]\n   for i,side in enumerate(['right','left']):\n    n=side+'_wheel_link';measured=np.asarray(ph['wheel_center_velocity_w']).reshape(2,3)[i]\n    max_v=max(max_v,float(np.linalg.norm(measured-vel[n])))\n    axis=axes[n];down=np.array([0.,0.,-1.]);radial=down-axis*np.dot(down,axis);radial=radial/np.linalg.norm(radial)*.1095\n    slip=measured+np.cross(omega[n],radial);slips.append(float(np.linalg.norm(slip[:2])))\n   cr.setdefault(s['episode_id'],[]).append({'time':time,'vz':float(whole[2]),'slip':slips,'wheel_forces':forces[2:].tolist()})\n  records=[]\n  for ep in a['statistics'][version][case]['episodes']:\n   if not ep['complete_success']:continue\n   air=ep['air_start_s'];x=cr[ep['episode']];times=np.array([v['time'] for v in x]);vz=np.array([v['vz'] for v in x])\n   flight=(times>=air+.015)&(times<=air+.095);backproject=vz[flight]+9.81*(times[flight]-air);takeoff=float(backproject.mean());start=float(np.interp(1.1,times,vz));closure=takeoff-start-ep['net_vertical_impulse_Ns']/mass\n   max_closure=max(max_closure,abs(closure))\n   push=(times>=1.1)&(times<=air);slips=np.array([v['slip'] for v in x])[push];forces=np.array([v['wheel_forces'] for v in x])[push];mask=forces>=10;weights=np.where(mask,forces,0)\n   row={'episode':ep['episode'],'mass_kg':mass,'air_start_s':air,'whole_body_com_vz_at_1p10_m_s':start,'whole_body_com_takeoff_vz_m_s':takeoff,'flight_backproject_spread_m_s':float(np.ptp(backproject)),'support_impulse_Ns':ep['support_impulse_1p10_to_air_Ns'],'net_impulse_Ns':ep['net_vertical_impulse_Ns'],'impulse_velocity_closure_error_m_s':float(closure),'loaded_wheel_slip_force_weighted_mean_m_s':float((slips*weights).sum()/weights.sum()),'loaded_wheel_slip_peak_m_s':float(slips[mask].max())}\n   records.append(row)\n  stats[version][case]=records\nassert max_fk<1e-5 and max_v<1e-4\nd={'version':1,'source':CODE_SOURCE,'inputs':inputs,'statistics':stats,'validation':{'max_joint_origin_fk_error_m':max_fk,'max_wheel_velocity_error_m_s':max_v,'max_impulse_velocity_closure_error_m_s':max_closure},'conventions':{'com':'Mass-weighted body COM velocity reconstructed from measured poses, root COM velocity, angular velocity, joint rates and URDF tree; exact wheel-origin velocity crosscheck. Takeoff vz estimated from 15..95ms flight window via v(t)+g*(t-takeoff).','slip':'20ms end-step proxy: ideal wheel radius0.1095m, full world wheel angular velocity including parent bodies, ground-facing radial tangent point. Force-weighted mean among wheelFz>=10N during1.1..takeoff. No contact-patch or friction telemetry: not slip energy or a causal loss measurement.','episodes':'Only five completed cycles per case; deterministic nominal repetitions, single seed; startup physical draws fixed within case.'}}\nwith (out/'push-off-dynamics.json').open('x') as f:json.dump(d,f,indent=2,allow_nan=False)\nprint('validation',d['validation'])\nfor v,cases in stats.items():\n for c,rr in cases.items():print(v,c,json.dumps(rr))\n",
