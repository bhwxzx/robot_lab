    "path": "/home/server/liufengrong/robot_lab/learnings/policy_tuning/RobotLab-Isaac-BeyondMimic-Flat-LW-wheel-v0/2026-11-09_12-58-20/evaluations/wheel-to-leg-wheel-links-20261110-001/contract.json",
